{
  "name": "@yaelg/ios-simulator-mcp",
  "version": "1.0.18",
  "description": "MCP server for interacting with the iOS simulator",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Tahul/ios-simulator-mcp"
  },
  "author": "Yaël GUILLOUX <yael.guilloux@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tahul/ios-simulator-mcp/issues"
  },
  "homepage": "https://github.com/Tahul/ios-simulator-mcp",
  "bin": {
    "ios-simulator-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "ios",
    "simulator",
    "mcp",
    "modelcontextprotocol"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.js",
    "dev": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@types/bun": "^1.3.13",
    "bumpp": "^11.0.1",
    "eslint": "^10.2.1",
    "jiti": "^2.6.1",
    "tsdown": "^0.22.0",
    "typescript": "~6.0.3"
  }
}
